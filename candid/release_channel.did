// Release channel: publishes signed firmware releases. Wallets do not trust
// it; they check every manifest's signatures and every chunk's hash, so the
// channel can withhold a release but cannot push a bad one. Draft 0, 2026-10-20.

import "common.did";

type ReleaseSummary = record {
  version : text;
  wasm_sha256 : blob;
  published_at_ns : nat64;
  notes_url : text;
};

type ChunkRequest = record {
  version : text;
  index : nat32;
};

type PublishChunk = record {
  version : text;
  index : nat32;
  data : blob;
};

type ChannelError = variant {
  NotPublisher;
  UnknownVersion : text;
  HashMismatch : record { index : nat32 };
  NotEnoughSignatures : record { have : nat8; need : nat8 };
  AlreadyPublished : text;
};

type ChannelResult = variant { Ok; Err : ChannelError };

service : {
  // Read side, used by wallets and the factory.
  latest : () -> (opt ReleaseManifest) query;
  manifest : (text) -> (opt ReleaseManifest) query;
  releases : () -> (vec ReleaseSummary) query;
  // A chunk of at most 1 MiB.
  chunk : (ChunkRequest) -> (opt blob) query;

  // Write side, publishers only. A manifest goes live once all its chunks
  // match their hashes and its signatures meet the channel's threshold.
  publish_chunk : (PublishChunk) -> (ChannelResult);
  publish_manifest : (ReleaseManifest) -> (ChannelResult);
};
