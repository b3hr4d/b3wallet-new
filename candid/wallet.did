// Firmware interface of a self-owned chain-key wallet canister.
// One canister per wallet; it is its own only controller. Draft 0, 2026-10-20.

import "common.did";
import "icrc21.did";

// ---- Install and upgrade arguments ----------------------------------------

type InitArgs = record {
  // Ed25519 public key (32 bytes) of the claim keypair. The private key only
  // ever lives in the claim link's URL fragment.
  claim_public_key : blob;
  claim_expires_at_ns : nat64;
  release_channel : principal;
  // Ed25519 public keys allowed to sign releases, and how many must sign.
  release_signers : vec blob;
  release_threshold : nat8;
  // The factory that created the wallet. Informational; it holds no rights.
  factory : opt principal;
  // The network of the default Bitcoin account, which also picks the
  // threshold key: key_1 for mainnet, test_key_1 for testnet, dfx_test_key
  // for regtest. None is mainnet.
  bitcoin_network : opt BitcoinNetwork;
};

type UpgradeArgs = record {
  // Sets the network of a wallet that has no Bitcoin or EVM account yet; once
  // it has one, an upgrade never changes it. Without one, a wallet keeps its
  // network, or takes that of its first Bitcoin account, or mainnet.
  bitcoin_network : opt BitcoinNetwork;
};

// The firmware installs itself with `Upgrade`; all state is in stable memory.
// `variant { Upgrade }` still decodes, as an upgrade without arguments.
type WalletArg = variant {
  Init : InitArgs;
  Upgrade : opt UpgradeArgs;
};

// ---- Members ----------------------------------------------------------------

// Owners propose, approve, run and reject; approvers approve and run;
// viewers only read. A proposer, such as an AI agent, reads and proposes
// transfers, and its approval never counts: each waits for an owner or an
// approver.
type Role = variant { Owner; Approver; Viewer; Proposer };

type Member = record {
  id : principal;
  role : Role;
  label : text;
  added_at_ns : nat64;
  // None for the member who claimed the wallet.
  added_by : opt principal;
};

// Signature by the claim key over the UTF-8 text
// "claim:<wallet canister id>:<caller principal>".
type ClaimArgs = record {
  signature : blob;
};

// ---- Accounts ---------------------------------------------------------------

type AccountId = nat32;

type AccountHolder = variant {
  // Derivation path: "wallet" / kind / index.
  Wallet;
  // Derivation path: "ext" / extension canister id / kind / index.
  Extension : principal;
};

// Indices count per kind, and per network for Bitcoin, from 0; every wallet
// has account 0 of each kind from the start. For an Internet Computer
// account, index n is the wallet's ICRC-1 subaccount n as 32 big-endian
// bytes, and index 0 is the plain principal. For Bitcoin, index n is the
// threshold ECDSA key of the path "wallet" / "bitcoin-<network>" / n as 4
// big-endian bytes, and the address is that key's P2WPKH address. For EVM,
// index n is the key of the path "wallet" / "evm" / n, and the address is
// that key's EIP-55 address on every EVM chain.
type Account = record {
  id : AccountId;
  kind : AccountKind;
  label : text;
  index : nat32;
  holder : AccountHolder;
  // An ICRC-1 account in its text form, a Bitcoin address, or an EVM address.
  address : text;
  // An Internet Computer account's ICP account identifier, as 64 hex digits:
  // the form exchanges ask for to send it ICP.
  icp_account_id : opt text;
};

type AddAccountArgs = record {
  kind : AccountKind;
  label : text;
};

type Balance = record {
  account : AccountId;
  asset : Chain;
  amount : nat;
  as_of_ns : nat64;
};

type AssetsResult = variant { Ok : vec Chain; Err : WalletError };

type Direction = variant { In; Out };

type HistoryEntry = record {
  seq : nat64;
  account : AccountId;
  direction : Direction;
  counterparty : text;
  amount : nat;
  // Ledger block index, Bitcoin txid, or EVM transaction hash, as text.
  tx_id : text;
  at_ns : nat64;
  // The action that sent it; none for incoming funds.
  action : opt ActionId;
};

type HistoryRequest = record {
  account : opt AccountId;
  before_seq : opt nat64;
  limit : nat16;
};

// ---- Actions, approvals and policy -------------------------------------------

type ActionId = nat64;

type TransferRequest = record {
  from : AccountId;
  // What it sends: ICP or a tracked ICRC-1 token from an Internet Computer
  // account, the bitcoin of a Bitcoin account's network, or the native token
  // of a tracked EVM chain from an EVM account. None is ICP, or the account's
  // bitcoin; `propose` stores the asset it sends.
  asset : opt Chain;
  // For ICP and ICRC, an ICRC-1 account in its text form; for Bitcoin, an
  // address of the account's network; for EVM, an address.
  to : text;
  // Base units of the asset: e8s, satoshis, or wei.
  amount : nat;
  // The ledger refuses a fee other than its own; none pays its own. For
  // Bitcoin, the whole fee in satoshis; none pays the median rate of recent
  // transactions. For EVM, the most it pays in fees, in wei; none pays the
  // chain's recent fees. A Bitcoin or EVM fee counts toward the daily limit.
  fee : opt nat;
  // At most 32 bytes. A Bitcoin or EVM transfer carries none.
  memo : opt blob;
};

type Action = variant {
  Transfer : TransferRequest;
  AddMember : record { id : principal; role : Role; label : text };
  RemoveMember : principal;
  ChangeRole : record { id : principal; role : Role };
  InstallExtension : record {
    canister : principal;
    granted : vec Permission;
    budgets : vec Budget;
  };
  UninstallExtension : principal;
  SetPolicy : Policy;
  Upgrade : record { version : text; wasm_sha256 : blob };
  // Makes a recovery controller (candid/controller.did) the wallet's only
  // controller, under the SetPolicy rule. Execute checks through the IC that
  // the controller runs controller_module_hash, was installed once and
  // fresh, and has no controller, and asks it that it serves this wallet
  // with the policy whose hash is controller_policy_sha256 and was not
  // replaced. Decision 0009, 2026-10-22.
  HandOverControl : record {
    controller : principal;
    controller_module_hash : blob;
    controller_policy_sha256 : blob;
  };
};

type ActionKind = variant {
  Transfer;
  AddMember;
  RemoveMember;
  ChangeRole;
  InstallExtension;
  UninstallExtension;
  SetPolicy;
  Upgrade;
};

type DailyLimit = record {
  chain : Chain;
  amount : nat;
};

type PolicyRule = record {
  kind : ActionKind;
  // Approvals needed, the proposer's included.
  quorum : nat8;
  timelock_ns : nat64;
  // A transfer that keeps its asset's spending over the last 24 hours within
  // these limits needs only the proposer and no timelock.
  daily_limits : vec DailyLimit;
};

type Policy = record {
  rules : vec PolicyRule;
};

type TxReceipt = record {
  account : AccountId;
  chain : Chain;
  tx_id : text;
  at_ns : nat64;
};

type Outcome = variant {
  Done;
  Sent : TxReceipt;
};

type ActionState = variant {
  // Needs more approvals.
  Waiting;
  // Quorum met; executable once `executable_after_ns` has passed.
  Ready;
  Executed : Outcome;
  Rejected : principal;
  Expired;
  Failed : text;
};

type Pending = record {
  id : ActionId;
  action : Action;
  proposed_by : principal;
  proposed_at_ns : nat64;
  approvals : vec principal;
  quorum : nat8;
  // Zero until the action has its quorum; then the end of its timelock.
  executable_after_ns : nat64;
  // The end of the seven-day approval window (an hour for a join request);
  // once the action has its quorum, seven days after its timelock ends. A
  // transfer whose ledger call may have run stays open until 24 hours after
  // that call, while the ledger can still find it. A Bitcoin transfer whose
  // transaction may have reached the Bitcoin canister never expires: execute
  // it again to send the same transaction. Once the Bitcoin canister took
  // it, the wallet sends it again on its own until the network confirms it.
  expires_at_ns : nat64;
  state : ActionState;
};

// ---- Extensions -------------------------------------------------------------

type Extension = record {
  canister : principal;
  manifest : ExtensionManifest;
  granted : vec Permission;
  budgets : vec Budget;
  spent_today : vec DailyLimit;
  installed_at_ns : nat64;
  installed_by : principal;
};

// What an extension's canister may ask, within what its owners granted.
type ExtRequest = variant {
  Accounts;
  Balances;
  ProposeTransfer : TransferRequest;
  SubWalletAddress : Chain;
  SubWalletTransfer : record {
    chain : Chain;
    to : text;
    amount : nat;
    memo : opt blob;
  };
};

type ExtResponse = variant {
  Accounts : vec Account;
  Balances : vec Balance;
  Proposed : ActionId;
  Address : text;
  Sent : TxReceipt;
};

// ---- Upgrade ------------------------------------------------------------------

// Staging: an Upgrade action's execute is uploading the release's chunks to
// the wallet's own chunk store; executing it again goes on from there.
// Installing: the install was sent. Until the new version runs or the
// deadline passes, the wallet calls nobody and refuses execute.
// Failed: the deadline passed with the old version still running.
type UpgradeState = variant {
  Idle;
  Staging : record {
    version : text;
    chunks_uploaded : nat32;
    chunks_total : nat32;
  };
  Installing : record {
    version : text;
    wasm_sha256 : blob;
    started_at_ns : nat64;
    deadline_ns : nat64;
  };
  Failed : record {
    version : text;
    reason : text;
    at_ns : nat64;
  };
};

// ---- Operations ---------------------------------------------------------------

type Status = record {
  version : text;
  claimed : bool;
  claim_expires_at_ns : opt nat64;
  cycles : nat;
  upgrade : UpgradeState;
  release_channel : principal;
  bitcoin_network : BitcoinNetwork;
};

type AuditEvent = variant {
  Claimed;
  JoinRequested : principal;
  AccountAdded : AccountId;
  AssetTracked : Chain;
  AssetUntracked : Chain;
  Proposed : ActionId;
  Approved : ActionId;
  Rejected : ActionId;
  Executed : ActionId;
  ExtensionCall : record { extension : principal; request : text };
  UpgradeStaged : text;
  UpgradeInstalled : text;
  UpgradeFailed : text;
  CyclesLow : nat;
};

type AuditEntry = record {
  seq : nat64;
  at_ns : nat64;
  // None for events the canister raises itself (timers).
  by : opt principal;
  event : AuditEvent;
};

type AuditRequest = record {
  before_seq : opt nat64;
  limit : nat16;
};

// ---- HTTP ---------------------------------------------------------------------

type HeaderField = record { text; text };

type HttpRequest = record {
  method : text;
  url : text;
  headers : vec HeaderField;
  body : blob;
  certificate_version : opt nat16;
};

// Every response is certified (response verification v2). Pages are
// prerendered at build, embedded in the release and certified at install and
// upgrade, never per request.
type HttpResponse = record {
  status_code : nat16;
  headers : vec HeaderField;
  body : blob;
};

// ---- Guard ------------------------------------------------------------------

// The guard (decision 0011) reads the person's own words, marks where the
// amount, asset, recipient and the rest are, and checks a pending transfer
// against them field by field; it also runs a keyword list over the
// proposer's label and the memo. It only adds flags for a person to read:
// it never approves or rejects, and NotChecked is never OK. The model is
// one 44 MB file that owners upload; the wallet loads only the file whose
// SHA-256 its release pins.

// Bytes of the guard file written at `offset`, at most 1,900,000 at once.
type GuardUploadArgs = record { offset : nat64; chunk : blob };

type GuardStatus = record {
  file_sha256 : blob;
  file_bytes : nat64;
  loaded : bool;
  // From the loaded file: the model's release and its weights' SHA-256.
  release : opt text;
  model_sha256 : opt text;
};

type GuardCheckArgs = record {
  action : ActionId;
  // The person's own words, as they asked the agent; at most 280 bytes.
  request : text;
};

// [start, end) in code points of the request, and the words there.
type GuardSpan = record { slot : text; start : nat32; end : nat32; text : text };

type GuardVerdict = variant { Same; Differs; NotChecked };

// One of amount, asset, chain, from, to, memo, fee.
type GuardField = record { field : text; verdict : GuardVerdict };

// Differs: a field differs or the request raised a flag. Matches: amount,
// asset and recipient are the same. Partial: nothing differs, but not all
// three could be checked.
type GuardOverall = variant { Differs; Matches; Partial };

// A cue (urgency, authority, approved, instruction) and the words that
// matched it.
type GuardMatch = record { cue : text; start : nat32; end : nat32; text : text };

// A text the approver reads: the proposer's label, the memo.
type GuardText = record {
  name : text;
  text : text;
  flags : vec text;
  matched : vec GuardMatch;
};

type GuardReport = record {
  // one_transfer, not_transfer, several_transfers, relative_amount,
  // other_currency or incomplete; only one_transfer is compared, and not
  // when the guard abstains.
  class : text;
  abstain : bool;
  confidence : float32;
  spans : vec GuardSpan;
  fields : vec GuardField;
  // says_not_to, repeats: the request's own words, whatever the guard read.
  request_flags : vec text;
  overall : GuardOverall;
  texts : vec GuardText;
  instructions : nat64;
};

// ---- Errors and results -----------------------------------------------------

type WalletError = variant {
  NotClaimed;
  AlreadyClaimed;
  ClaimExpired;
  BadSignature;
  NotAMember;
  Forbidden : text;
  NotFound : text;
  InvalidArgument : text;
  PolicyViolation : text;
  BudgetExceeded : record { chain : Chain; remaining : nat };
  TimelockActive : record { executable_after_ns : nat64 };
  QuorumNotMet : record { approvals : nat8; quorum : nat8 };
  UpgradeInProgress;
  ReleaseRejected : text;
  ChainError : text;
  // Cycles the wallet can spend above what it keeps to stay running.
  InsufficientCycles : record { available : nat; needed : nat };
};

type MemberResult = variant { Ok : Member; Err : WalletError };
type MembersResult = variant { Ok : vec Member; Err : WalletError };
type AccountResult = variant { Ok : Account; Err : WalletError };
type AccountsResult = variant { Ok : vec Account; Err : WalletError };
type BalanceResult = variant { Ok : Balance; Err : WalletError };
type HistoryResult = variant { Ok : vec HistoryEntry; Err : WalletError };
type PendingResult = variant { Ok : Pending; Err : WalletError };
type PendingListResult = variant { Ok : vec Pending; Err : WalletError };
type PolicyResult = variant { Ok : Policy; Err : WalletError };
type ExtensionsResult = variant { Ok : vec Extension; Err : WalletError };
type ExtResult = variant { Ok : ExtResponse; Err : WalletError };
type ReleaseResult = variant { Ok : opt ReleaseManifest; Err : WalletError };
type AuditResult = variant { Ok : vec AuditEntry; Err : WalletError };
type GuardUploadResult = variant { Ok : nat64; Err : WalletError };
type GuardStatusResult = variant { Ok : GuardStatus; Err : WalletError };
type GuardCheckResult = variant { Ok : GuardReport; Err : WalletError };

type SupportedStandard = record { name : text; url : text };

service : (WalletArg) -> {
  // Claim and members. Before the claim, only claim, status and http_request answer.
  claim : (ClaimArgs) -> (MemberResult);
  whoami : () -> (opt Member) query;
  members : () -> (MembersResult) query;
  // A signed-in non-member asks to join; creates a pending AddMember action
  // that adds the caller as a Viewer, or as a Proposer when it asks for that
  // role. Asking again returns the open request.
  request_join : (text, opt Role) -> (PendingResult);

  // Accounts. add_account is for owners and needs no approval: it moves nothing.
  accounts : () -> (AccountsResult) query;
  add_account : (AddAccountArgs) -> (AccountResult);
  // Update: asks the ledger, the Bitcoin canister or the EVM RPC canister for
  // what an account holds of an asset: none is ICP, or the account's bitcoin;
  // an EVM account names its chain.
  // A Bitcoin balance leaves out what the wallet's transactions spend and
  // counts their change, before the network confirms them.
  balance : (AccountId, opt Chain) -> (BalanceResult);
  // The assets the accounts show: ICP first, then the ICRC-1 ledgers and EVM
  // chains owners track; a new wallet tracks Ethereum, or Sepolia on test
  // keys. Tracking moves nothing, so owners change it without approval.
  // Tracking a ledger asks it for its standards, and refuses a canister that
  // is not an ICRC-1 ledger; an EVM chain must be one the EVM RPC canister
  // has providers of, and Sepolia alone on test keys.
  assets : () -> (AssetsResult) query;
  track_asset : (Chain) -> (AssetsResult);
  untrack_asset : (Chain) -> (AssetsResult);
  history : (HistoryRequest) -> (HistoryResult) query;

  // Actions: every transfer, membership, extension, policy and upgrade change.
  propose : (Action) -> (PendingResult);
  approve : (ActionId) -> (PendingResult);
  reject : (ActionId) -> (PendingResult);
  // A transfer or an upgrade makes one call at a time; a second execute
  // while it is in flight is refused.
  execute : (ActionId) -> (PendingResult);
  pending : () -> (PendingListResult) query;
  policy : () -> (PolicyResult) query;

  // Extensions. ext_request accepts only a registered extension canister as caller.
  extensions : () -> (ExtensionsResult) query;
  ext_request : (ExtRequest) -> (ExtResult);

  // The guard. guard_upload and guard_load are for owners; guard_upload
  // returns where the bytes written end, and guard_load refuses a file
  // other than the one the release pins. guard_check is for owners and
  // approvers, as a query only.
  guard_upload : (GuardUploadArgs) -> (GuardUploadResult);
  guard_load : () -> (GuardStatusResult);
  guard_status : () -> (GuardStatus) query;
  guard_check : (GuardCheckArgs) -> (GuardCheckResult) query;

  // Upgrade. release_available is an update: it reads the release channel's
  // latest release and returns it if this wallet would install it (enough
  // signatures by its pinned keys, tested from the module it runs), none if
  // the channel has none or the wallet runs it, and ReleaseRejected
  // otherwise. An Upgrade action's execute checks all of it again.
  release_available : () -> (ReleaseResult);
  upgrade_status : () -> (UpgradeState) query;

  // Operations.
  status : () -> (Status) query;
  // Newest first, at most 100 entries.
  audit_log : (AuditRequest) -> (AuditResult) query;
  // Query only: the start page at / and /index.html, the send, receive,
  // account, approvals, notifications, settings, members and claim pages at
  // /send, /receive, /account, /approvals, /notifications, /settings,
  // /members and /claim, the app at /app.js and /app.css, and a certified 404
  // for any other path. See "Serve a page" in docs/design.md.
  http_request : (HttpRequest) -> (HttpResponse) query;

  // Standards for the signer window (ICRC-25, ICRC-29) and consent (ICRC-21).
  icrc10_supported_standards : () -> (vec SupportedStandard) query;
  icrc21_canister_call_consent_message : (icrc21_consent_message_request) -> (icrc21_consent_message_response);
};
